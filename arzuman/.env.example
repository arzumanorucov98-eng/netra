# =============================================================
# Arzuman — mühit dəyişənləri şablonu
# .env adı ilə köçürüb öz açarlarınla doldur. .env commit edilmir.
# =============================================================

# --- Anthropic (Claude Agent SDK) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Attio (CRM) ---
# https://app.attio.com/settings/api adresindən token yarat
ATTIO_API_KEY=

# --- Gmail (satış email-ləri) ---
# İdeal olaraq ayrıca biznes Gmail hesabı.
# OAuth axını üçün lazım olan client_id/secret:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

# --- Vibe Prospecting (müştəri axtarışı) ---
# 150M+ şirkət bazası — email/sahə/ölkə üzrə axtarış
VIBE_PROSPECTING_API_KEY=

# --- Netlify (sayt deploy) ---
# https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# --- Telegram (mobil təsdiq körpüsü — Mərhələ 2) ---
# BotFather-dan bot yaradıb tokeni bura yaz
TELEGRAM_BOT_TOKEN=
# Sənin şəxsi Telegram chat_id-n (təsdiq mesajlarını bura göndərəcək)
TELEGRAM_OWNER_CHAT_ID=

# --- Operator adı (Arzuman kimə "sən" deyəcək) ---
OPERATOR_NAME=Arzuman
